{
  "name": "petrolero-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "local:setup": "node scripts/setup-local-backend.mjs",
    "local:up": "docker compose --env-file .env.local -f compose.local.yml up -d --wait",
    "local:db:deploy": "node --env-file=.env.local scripts/check-local-backend.mjs --target-only && prisma migrate deploy && prisma generate",
    "local:check": "node --env-file=.env.local scripts/check-local-backend.mjs",
    "local:down": "docker compose --env-file .env.local -f compose.local.yml down"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.186.1",
    "@better-auth/prisma-adapter": "^1.0.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "better-auth": "^1.7.0",
    "dotenv": "^17.0.0",
    "nodemailer": "^7.0.0",
    "pg": "^8.0.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.0.0",
    "prisma": "^7.0.0"
  }
}
